// Prisma schema for DynamicMenu.
// Phase 1 adds the tenant core: User, Restaurant, RestaurantMembership.
// Further domain models are added in their own phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  STAFF
}

enum RestaurantStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum MenuStatus {
  DRAFT
  PUBLISHED
}

enum DietaryTag {
  VEG
  NON_VEG
  VEGAN
  SPICY
  GLUTEN_FREE
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships RestaurantMembership[]

  @@index([clerkId])
}

model Restaurant {
  id           String           @id @default(cuid())
  name         String
  slug         String           @unique
  // Phase 15 — multi-branch: a branch is a child restaurant (one level deep).
  parentId     String?
  status       RestaurantStatus @default(ACTIVE)
  // Phase 2 — onboarding profile (all optional; see PHASES.md §6)
  description   String?
  cuisine       String?
  phone         String?
  email         String?
  websiteUrl    String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  postalCode    String?
  country       String?
  logoUrl       String?
  primaryColor  String?
  googleMapsUrl String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  memberships RestaurantMembership[]
  menus       Menu[]
  theme       RestaurantTheme?
  tables      RestaurantTable[]
  offers      Offer[]
  orders      Order[]
  reviews     Review[]
  customers   Customer[]
  loyaltyAccounts LoyaltyAccount[]
  subscription Subscription?
  parent      Restaurant?  @relation("RestaurantBranches", fields: [parentId], references: [id], onDelete: SetNull)
  branches    Restaurant[] @relation("RestaurantBranches")

  @@index([slug])
  @@index([status])
  @@index([parentId])
}

// ── Phase 3 — Menu management (PHASES.md §7) ─────────────────────────────
// The draft tree (Menu → MenuSection → MenuItem → variants/addons) is the
// editable working copy. Publishing validates it and writes a self-contained
// MenuRevision snapshot; customer-facing endpoints serve snapshots only, so
// draft edits never leak to the live menu (ARCHITECTURE.md §11).

model Menu {
  id                String      @id @default(cuid())
  restaurantId      String
  name              String
  description       String?
  status            MenuStatus  @default(DRAFT)
  isActive          Boolean     @default(true)
  archivedAt        DateTime?
  // Latest published snapshot; null while DRAFT.
  currentRevisionId String?     @unique
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  restaurant Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  currentRevision MenuRevision? @relation("MenuCurrentRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)
  sections    MenuSection[]
  revisions   MenuRevision[]

  @@index([restaurantId, status])
  @@index([restaurantId, archivedAt])
}

model MenuRevision {
  id           String   @id @default(cuid())
  menuId       String
  snapshot     Json
  sectionCount Int
  itemCount    Int
  publishedAt  DateTime @default(now())

  menu          Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)
  currentOfMenu Menu? @relation("MenuCurrentRevision")

  @@index([menuId, publishedAt])
}

model MenuSection {
  id          String   @id @default(cuid())
  menuId      String
  name        String
  description String?
  position    Int      @default(0)
  isHidden    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  menu  Menu      @relation(fields: [menuId], references: [id], onDelete: Cascade)
  items MenuItem[]

  @@index([menuId, position])
}

model MenuItem {
  id          String       @id @default(cuid())
  sectionId   String
  name        String
  description String?
  imageUrl    String?
  price       Decimal      @db.Decimal(10, 2)
  isAvailable Boolean      @default(true)
  dietaryTags DietaryTag[]
  position    Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  section  MenuSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  variants MenuItemVariant[]
  addons   MenuItemAddon[]

  @@index([sectionId, position])
}

model MenuItemVariant {
  id          String   @id @default(cuid())
  itemId      String
  name        String
  price       Decimal  @db.Decimal(10, 2)
  isAvailable Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  item MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, position])
}

model MenuItemAddon {
  id          String   @id @default(cuid())
  itemId      String
  name        String
  price       Decimal  @db.Decimal(10, 2)
  isAvailable Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  item MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, position])
}

// ── Phase 4 — Theme system (PHASES.md §8) ────────────────────────────────
// A theme is a presentation layer: stored as JSON config, applied to menu
// data at render time. Draft/published split mirrors menus; editing a theme
// never touches menu rows (ARCHITECTURE.md §12).

model RestaurantTheme {
  id             String    @id @default(cuid())
  restaurantId   String    @unique
  draftConfig    Json?
  publishedConfig Json?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

// ── Phase 5 — Tables & QR (PHASES.md §9) ─────────────────────────────────
// The QR token (not internal ids) is the public identity of a table; it
// resolves table → restaurant for customer scans (ARCHITECTURE.md §9/§16).

model RestaurantTable {
  id           String   @id @default(cuid())
  restaurantId String
  label        String
  qrToken      String   @unique
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@index([restaurantId])
}

// ── Phase 6 — Customer menu / offers (PHASES.md §10) ───────────────────────
// Lightweight promotional offers displayed on the customer menu. Complex
// discount rules and scheduling belong to a later phase; this model only
// supports simple active/inactive banners (title, description, badge, image).

// ── Phase 13 — Offers & campaigns (PHASES.md §17) ──────────────────────────
// An offer is a promotional campaign: a banner shown on the customer menu,
// optionally with an order discount (percent or flat) and a schedule window.
// Discounts are applied automatically at order creation, server-side.

enum OfferDiscountType {
  PERCENT
  FLAT
}

model Offer {
  id            String             @id @default(cuid())
  restaurantId  String
  title         String
  description   String?
  badgeText     String?
  imageUrl      String?
  discountType  OfferDiscountType?
  discountValue Decimal?           @db.Decimal(10, 2)
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean            @default(true)
  position      Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@index([restaurantId, isActive, position])
}

// ── Phase 14 — SaaS subscriptions (PHASES.md §18, ARCHITECTURE.md §45) ─────
// Restaurant → Subscription → Plan → Feature Entitlements. Plans are a
// static catalog (modules/billing/plans.ts); billing provider integration is
// intentionally absent until project requirements define it — plan changes
// are self-serve account management, not payment events.

enum Plan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
}

model Subscription {
  id           String             @id @default(cuid())
  restaurantId String             @unique
  plan         Plan               @default(FREE)
  status       SubscriptionStatus @default(ACTIVE)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model RestaurantMembership {
  id           String     @id @default(cuid())
  userId       String
  restaurantId String
  role         Role       @default(STAFF)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@index([restaurantId])
  @@index([userId, restaurantId])
}

// ── Phase 7 — Cart & ordering (PHASES.md §11) ──────────────────────────────
// Orders are state machines created from a scanned QR token. Prices are
// recomputed server-side from the published menu snapshot; the frontend only
// sends item/variant/addon ids and quantities.

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  SERVED
  PAID
  COMPLETED
  CANCELLED
  REJECTED
}

model Order {
  id            String      @id @default(cuid())
  restaurantId  String
  tableId       String
  customerId    String?
  status        OrderStatus @default(PENDING)
  customerName  String?
  customerPhone String?
  customerEmail String?
  notes         String?
  subtotal      Decimal     @db.Decimal(10, 2)
  discount      Decimal     @db.Decimal(10, 2) @default(0)
  total         Decimal     @db.Decimal(10, 2)
  offerId       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table      RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  customer   Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  offer      Offer?          @relation(fields: [offerId], references: [id], onDelete: SetNull)
  items      OrderItem[]
  review     Review?

  @@index([restaurantId, status, createdAt])
  @@index([tableId, createdAt])
  @@index([customerId])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  menuItemId  String
  name        String
  quantity    Int
  basePrice   Decimal @db.Decimal(10, 2)
  variantId   String?
  variantName String?
  variantPrice Decimal? @db.Decimal(10, 2)
  subtotal    Decimal @db.Decimal(10, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  addons  OrderItemAddon[]

  @@index([orderId])
}

model OrderItemAddon {
  id      String @id @default(cuid())
  orderItemId String
  addonId String
  name    String
  price   Decimal @db.Decimal(10, 2)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
}

// ── Phase 10 — Customer management (PHASES.md §14) ─────────────────────────
// Customers are restaurant-scoped (never global). Identity within a
// restaurant is the customer's phone number; profiles are created/updated
// automatically when an order is placed.

model Customer {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  phone        String
  email        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders     Order[]
  loyalty    LoyaltyAccount?

  @@unique([restaurantId, phone])
  @@index([restaurantId])
}

// ── Phase 12 — Loyalty Program (PHASES.md §16) ─────────────────────────────
// Customers earn points on paid orders (1 point per 100 spent, floored) and
// redeem them at the counter. All balances are restaurant-scoped.

enum LoyaltyTransactionType {
  EARN
  REDEEM
  ADJUST
}

model LoyaltyAccount {
  id               String   @id @default(cuid())
  restaurantId     String
  customerId       String   @unique
  points           Int      @default(0)
  lifetimeEarned   Int      @default(0)
  lifetimeRedeemed Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  restaurant   Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]

  @@index([restaurantId])
}

model LoyaltyTransaction {
  id        String                 @id @default(cuid())
  accountId String
  type      LoyaltyTransactionType
  points    Int
  reason    String?
  orderId   String?
  createdAt DateTime               @default(now())

  account LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([orderId])
}

// ── Phase 9 — Payment status & reviews (PHASES.md §13) ─────────────────────
// In-app feedback collected after the restaurant marks an order PAID. Google
// review redirects are tracked as "opened" only — DynamicMenu cannot verify
// that a Google review was actually posted.

model Review {
  id                String    @id @default(cuid())
  orderId           String    @unique
  restaurantId      String
  rating            Int
  comment           String?
  googleMapsOpenedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
}
