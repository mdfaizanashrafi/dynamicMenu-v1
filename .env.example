# ── Database (Neon PostgreSQL) ─────────────────────────────
# Server-side only. Never commit real values.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Clerk ──────────────────────────────────────────────────
# Publishable key is safe for the frontend; secret key is server-side only.
CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SECRET="whsec_..."

# ── Sentry ─────────────────────────────────────────────────
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# ── API ────────────────────────────────────────────────────
API_PORT=4000
API_BASE_URL="http://localhost:4000"
# Production: https://api.dynamicmenu.store (or your Render custom domain)
CORS_ORIGIN="http://localhost:5173"
# Production: https://dynamicmenu.store
WEB_BASE_URL="http://localhost:5173"
# Production: https://dynamicmenu.store
# Local image storage directory (relative to apps/api); swap the storage
# provider for S3/Cloudinary before production (ARCHITECTURE.md §28).
UPLOAD_DIR="uploads"

# ── Frontend (Vite: VITE_ prefix required) ─────────────────
VITE_API_BASE_URL="http://localhost:4000"
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."
VITE_SENTRY_DSN=""
